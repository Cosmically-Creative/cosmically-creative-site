# Cosmically Creative — Apache / LiteSpeed
# Canonical host: https://www.cosmicallycreative.com

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 301 HTTP → HTTPS and apex → www (single hop)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.cosmicallycreative\.com$ [NC]
  RewriteRule ^ https://www.cosmicallycreative.com%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType application/xml .xml

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloud.umami.is; form-action https://formbold.com; frame-ancestors 'self'; base-uri 'self'"
</IfModule>
